<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/how_are_you_today"
                android:textColor="@color/foreground"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/muted_foreground"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Выбор настроения -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Как вы себя чувствуете?"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/mood_selector_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/mood_terrible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:background="@drawable/mood_item_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_terrible"
                    android:textColor="@color/foreground"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mood_bad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:background="@drawable/mood_item_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_bad"
                    android:textColor="@color/foreground"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mood_neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:background="@drawable/mood_item_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_neutral"
                    android:textColor="@color/foreground"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mood_good"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:background="@drawable/mood_item_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_good"
                    android:textColor="@color/foreground"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mood_great"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:background="@drawable/mood_item_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_great"
                    android:textColor="@color/foreground"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Интенсивность -->
        <TextView
            android:id="@+id/intensity_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Интенсивность: 3/5"
            android:textColor="@color/foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/intensity_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:max="4"
            android:progress="2" />

        <!-- Подсказка -->
        <TextView
            android:id="@+id/tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/note_background"
            android:padding="16dp"
            android:textColor="@color/foreground"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="" />

        <!-- Эмоции -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/what_do_you_feel"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_emotion_радость"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="радость"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_emotion_тревога"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="тревога"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_emotion_спокойствие"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="спокойствие"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_emotion_грусть"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="грусть"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_emotion_волнение"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="волнение"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_emotion_стресс"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="стресс"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_emotion_благодарность"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="благодарность"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_emotion_одиночество"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="одиночество"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Активности -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/what_did_you_do"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_activity_работа"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="работа"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_activity_спорт"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="спорт"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_activity_друзья"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="друзья"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_activity_отдых"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="отдых"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_activity_семья"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="семья"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_activity_хобби"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="хобби"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_activity_медитация"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="медитация"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tag_activity_чтение"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/tab_switcher_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="чтение"
                    android:textColor="@color/foreground"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Заметки -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Дополнительные заметки"
            android:textColor="@color/foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/notes_edit_text"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/note_background"
            android:gravity="top"
            android:hint="Расскажите подробнее о своем дне..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/muted_foreground"
            android:textSize="14sp" />

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/cancel"
                android:textColor="@color/muted_foreground" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/save_button_background"
                android:text="@string/save"
                android:textColor="@color/primary_foreground" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
