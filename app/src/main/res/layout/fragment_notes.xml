<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/notes_and_tasks"
            android:textColor="@color/foreground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/track_thoughts"
            android:textColor="@color/muted_foreground"
            android:textSize="16sp" />

        <!-- Переключатель вкладок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/tab_switcher_background"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/notes_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/tab_active_background"
                android:text="@string/notes"
                android:textColor="@color/accent_foreground"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tasks_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/tab_inactive_background"
                android:text="@string/tasks"
                android:textColor="@color/muted_foreground"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Поле поиска -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/edit_text_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:tint="@color/muted_foreground" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:textColor="@color/foreground"
                android:textColorHint="@color/muted_foreground"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/muted_foreground" />

        </LinearLayout>

        <!-- Контент заметок -->
        <LinearLayout
            android:id="@+id/notes_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Кнопка добавления заметки -->
            <LinearLayout
                android:id="@+id/add_note_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/add_button_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/color_purple" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_note"
                    android:textColor="@color/color_purple"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Сортировка и фильтры заметок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/note_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:id="@+id/filter_tag_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/filter_all"
                        android:textColor="@color/muted_foreground"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/clear_filter_tag"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/muted_foreground" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sort_notes_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/tab_inactive_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/sort_notes_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_sort_desc"
                        app:tint="@color/muted_foreground" />

                    <TextView
                        android:id="@+id/sort_notes_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_newest"
                        android:textColor="@color/muted_foreground"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Форма добавления заметки -->
            <LinearLayout
                android:id="@+id/add_note_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/note_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Новая заметка"
                    android:textColor="@color/foreground"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/note_title_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/note_background"
                            android:hint="@string/note_title_hint"
                            android:inputType="text"
                            android:padding="12dp"
                            android:textColor="@color/foreground"
                            android:textColorHint="@color/muted_foreground"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/note_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/note_background"
                            android:gravity="top"
                            android:hint="@string/write_note"
                            android:inputType="textMultiLine"
                            android:minHeight="120dp"
                            android:padding="12dp"
                            android:textColor="@color/foreground"
                            android:textColorHint="@color/muted_foreground"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/select_tags"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/predefined_tags_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/custom_tags_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/save_note_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/save_button_background"
                        android:text="@string/save"
                        android:textColor="@color/primary_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/cancel_note_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/cancel"
                        android:textColor="@color/muted_foreground"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Список заметок -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notes_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_note" />

        </LinearLayout>

        <!-- Контент задач -->
        <LinearLayout
            android:id="@+id/tasks_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Кнопка добавления задачи -->
            <LinearLayout
                android:id="@+id/add_task_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/add_task_button_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_task"
                    android:textColor="@color/secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Фильтры и сортировка -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/filter_all"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tab_active_background"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/filter_all"
                    android:textColor="@color/accent_foreground"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/filter_active"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tab_inactive_background"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/filter_active"
                    android:textColor="@color/muted_foreground"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/filter_completed"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tab_inactive_background"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/filter_completed"
                    android:textColor="@color/muted_foreground"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/sort_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/tab_inactive_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/sort_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_sort_desc"
                        app:tint="@color/muted_foreground" />

                    <TextView
                        android:id="@+id/sort_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_newest"
                        android:textColor="@color/muted_foreground"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Форма добавления задачи -->
            <LinearLayout
                android:id="@+id/add_task_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/note_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Новая задача"
                    android:textColor="@color/foreground"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/task_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/note_background"
                            android:hint="@string/task_title_hint"
                            android:inputType="text"
                            android:padding="12dp"
                            android:textColor="@color/foreground"
                            android:textColorHint="@color/muted_foreground"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/task_description_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/note_background"
                            android:gravity="top"
                            android:hint="@string/task_description_placeholder"
                            android:inputType="textMultiLine"
                            android:minHeight="120dp"
                            android:padding="12dp"
                            android:textColor="@color/foreground"
                            android:textColorHint="@color/muted_foreground"
                            android:textSize="14sp" />

                    </LinearLayout>

                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/save_task_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/save_task_button_background"
                        android:text="@string/save"
                        android:textColor="@color/primary_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/cancel_task_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/cancel"
                        android:textColor="@color/muted_foreground"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Список задач -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasks_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_task" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
