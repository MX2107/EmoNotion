<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Android 12+ (API 31+) -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/color_red</item>
        <item name="colorOnPrimary">@color/primary_foreground</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/mood_good</item>
        <item name="colorOnSecondary">@color/secondary_foreground</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Window background. -->
        <item name="android:windowBackground">@color/background</item>
        <!-- Edge-to-edge support for Android 12+ -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Theme without ActionBar for MainActivity -->
    <style name="Theme.MyApplication.NoActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
