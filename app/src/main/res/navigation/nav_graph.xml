<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.emonotion.app.presentation.home.HomeFragment"
        android:label="Главная"
        tools:layout="@layout/fragment_home">
        
        <action
            android:id="@+id/action_homeFragment_to_dailyEntryFragment"
            app:destination="@id/dailyEntryFragment" />
        
        <action
            android:id="@+id/action_homeFragment_to_notesFragment"
            app:destination="@id/navigation_notes" />
        
        <action
            android:id="@+id/action_homeFragment_to_calendarFragment"
            app:destination="@id/navigation_calendar" />
        
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/navigation_profile" />
        
        <action
            android:id="@+id/action_homeFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.emonotion.app.presentation.calendar.CalendarFragment"
        android:label="Календарь"
        tools:layout="@layout/fragment_calendar">
        
        <action
            android:id="@+id/action_calendarFragment_to_dailyEntryFragment"
            app:destination="@id/dailyEntryFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_notes"
        android:name="com.emonotion.app.presentation.notes.NotesFragment"
        android:label="Заметки"
        tools:layout="@layout/fragment_notes" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.emonotion.app.presentation.profile.ProfileFragment"
        android:label="Профиль"
        tools:layout="@layout/fragment_profile">
        
        <action
            android:id="@+id/action_profileFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
            
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/dailyEntryFragment"
        android:name="com.emonotion.app.presentation.dailyentry.DailyEntryFragment"
        android:label="Дневная запись"
        tools:layout="@layout/fragment_daily_entry">
        
        <argument
            android:name="date"
            android:defaultValue=""
            app:nullable="true"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.emonotion.app.presentation.analytics.AnalyticsFragment"
        android:label="Аналитика"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.emonotion.app.presentation.settings.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settingsFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_customEmotionsFragment"
            app:destination="@id/customEmotionsFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_customActivitiesFragment"
            app:destination="@id/customActivitiesFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_customTagsFragment"
            app:destination="@id/customTagsFragment" />
    </fragment>

    <fragment
        android:id="@+id/customEmotionsFragment"
        android:name="com.emonotion.app.presentation.settings.CustomEmotionsFragment"
        android:label="Редактировать эмоции"
        tools:layout="@layout/fragment_custom_emotions" />

    <fragment
        android:id="@+id/customActivitiesFragment"
        android:name="com.emonotion.app.presentation.settings.CustomActivitiesFragment"
        android:label="Редактировать активности"
        tools:layout="@layout/fragment_custom_activities" />

    <fragment
        android:id="@+id/customTagsFragment"
        android:name="com.emonotion.app.presentation.settings.CustomTagsFragment"
        android:label="Редактировать теги"
        tools:layout="@layout/fragment_custom_tags" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.emonotion.app.presentation.profile.EditProfileFragment"
        android:label="Редактировать профиль"
        tools:layout="@layout/fragment_edit_profile" />

</navigation>
